# Base URL of your backend API.
# Local dev on a physical phone: use your computer's LAN IP, e.g. http://192.168.1.20:4000
# Android emulator: http://10.0.2.2:4000
# Deployed: https://campus-companion-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth Web client ID (same one used by the backend) for Google Sign-In.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
