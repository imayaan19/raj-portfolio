# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ───────────────────────────────────────────
# Local: postgresql://postgres:postgres@localhost:5432/campus?schema=public
# Render injects this automatically via render.yaml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus?schema=public"

# ── Auth ───────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# ── Google OAuth / Gmail API ───────────────────────────
# From Google Cloud Console → Credentials → OAuth 2.0 Web client
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/gmail/callback"

# After the Gmail OAuth callback we redirect the browser back to the app.
# For Expo Go dev this can be a deep link; for a quick test use a success page.
GMAIL_POST_CONNECT_REDIRECT="http://localhost:4000/api/gmail/connected"

# Comma-separated keywords the Gmail parser searches for
GMAIL_KEYWORDS="feedback,evaluation,survey,deadline,course review"

# Where to look for the keywords: "subject" (default, high signal — matches
# feedback/deadline announcements and filters out newsletters) or "body"
# (searches everywhere, more results but noisier).
GMAIL_SEARCH_SCOPE="subject"
