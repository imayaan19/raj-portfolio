# ---------------------------------------------------------------------------
# MoneySense AI — Environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local`. NEVER expose the OpenAI key to the browser.
# ---------------------------------------------------------------------------

# Supabase (from your Supabase project → Settings → API)
# Safe to expose to the browser (public anon key + project URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Supabase service role key. Used for admin tasks such as
# account deletion and demo seeding. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — server-only. Powers the AI Copilot, Can-I-Afford reasoning,
# insights and receipt vision. NEVER prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-openai-key
# Optional: override the default model.
OPENAI_MODEL=gpt-4o-mini

# App URL (used for auth redirects). In production set to your Vercel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo account credentials (used by the "Try the demo" button and seed script).
NEXT_PUBLIC_DEMO_EMAIL=demo@moneysense.ai
DEMO_PASSWORD=Demo123!moneysense
